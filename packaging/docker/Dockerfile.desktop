FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    libgtk-3-0 \
    libwebkit2gtk-4.1-0 \
    libayatana-appindicator3-1 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango1.0-0 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY packages/desktop/src-tauri/target/release/openwork /usr/local/bin/openwork
COPY packages/desktop/src-tauri/target/release/openwork-server /usr/local/bin/openwork-server
COPY packages/desktop/src-tauri/target/release/openwork-orchestrator /usr/local/bin/openwork-orchestrator
COPY packages/desktop/src-tauri/target/release/opencode /usr/local/bin/opencode
COPY packages/desktop/src-tauri/target/release/opencode-router /usr/local/bin/opencode-router
COPY packages/desktop/src-tauri/target/release/versions.json /usr/local/share/openwork/versions.json

RUN chmod +x /usr/local/bin/openwork && \
    mkdir -p /data/openwork-orchestrator /workspace /var/run/dbus

ENV DISPLAY=:99
ENV OPENWORK_DATA_DIR=/data/openwork-orchestrator
ENV OPENWORK_WORKSPACE=/workspace
ENV DBUS_SESSION_BUS_ADDRESS=unix:path=/var/run/dbus/session

EXPOSE 8787 5173 6080

RUN echo '#!/bin/bash\n\
xvfb-run -a -s "-screen 0 1920x1080x24" /usr/local/bin/openwork --no-sandbox\
' > /start.sh && chmod +x /start.sh

CMD ["/start.sh"]
